[Unit]
Description=EdgeRunner live trading API + scheduler
After=network-online.target
Wants=network-online.target
# These belong in [Unit], not [Service] — systemd ignores them (with a warning)
# in [Service], leaving the crash-loop guard silently inactive.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=edgerunner
Group=edgerunner
# Lets GET /api/controls/logs shell out to journalctl. Without this journald
# returns an empty read (not an error) for other units, so the endpoint would
# silently report "no logs" instead of failing.
SupplementaryGroups=systemd-journal
WorkingDirectory=/opt/edgerunner/app
EnvironmentFile=/opt/edgerunner/gcp.env

# Single worker, deliberately. The scheduler runs inside the FastAPI lifespan
# (api/main.py), so N workers would mean N schedulers racing the same broker
# account. It also keeps RSS to one Python heap on a 1 GB box.
ExecStart=/opt/edgerunner/venv/bin/uvicorn api.main:app --host 127.0.0.1 --port ${PORT} --workers 1

# Don't hammer Alpaca if the process crash-loops on a bad config; the limit
# itself is declared in [Unit] above.
Restart=always
RestartSec=10

# The OOM killer picking this process over sshd is the desired outcome: losing
# the trader is recoverable, losing access to the box is not.
OOMScoreAdjust=200

# Give in-flight orders a chance to settle before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=edgerunner

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/edgerunner/state

[Install]
WantedBy=multi-user.target
